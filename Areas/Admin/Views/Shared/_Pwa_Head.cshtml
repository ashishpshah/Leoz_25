@* PWA head tags (Android & Apple iOS) : include inside <head> of every full page (admin layout, login, forgot password). *@
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#111e38" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Leoz" />
@* Logged-in user id for the service worker : offline saves are only sent back for the same user *@
<meta name="leoz-user" content="@Common.LoggedUser_Id()" />
@* "Remember Me" login : offline the app keeps the user logged in for 14 days, otherwise 30 minutes idle *@
<meta name="leoz-remember" content="@(Common.Get_Session_Int(SessionKey.KEY_REMEMBER_ME) == 1 ? 1 : 0)" />
<link rel="apple-touch-icon" href="~/assets/images/logo.webp" />
<link rel="stylesheet" href="~/css/pwa-install.css" asp-append-version="true" />

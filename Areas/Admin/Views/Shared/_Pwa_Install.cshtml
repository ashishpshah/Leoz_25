@* PWA install UI + service worker registration : include just before </body> of every full page (admin layout, login, forgot password). *@

<!-- Floating PWA Install Banner -->
<div id="pwa-install-banner" class="pwa-floating-banner">
	<div class="pwa-banner-left">
		<div class="pwa-banner-icon">
			<img src="~/assets/images/LeozLogo.jpeg" alt="Leoz Logo" />
		</div>
		<div class="pwa-banner-text">
			<span class="pwa-banner-title">Leoz App</span>
			<span class="pwa-banner-sub">Fast loading &amp; works offline!</span>
		</div>
	</div>
	<div class="pwa-banner-right">
		<button id="pwa-install-btn" class="pwa-btn-install" type="button">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
				<polyline points="7 10 12 15 17 10"></polyline>
				<line x1="12" y1="15" x2="12" y2="3"></line>
			</svg>
			<span>Install</span>
		</button>
		<button id="pwa-close-btn" class="pwa-btn-close" type="button" aria-label="Close">&times;</button>
	</div>
</div>

<!-- Apple iOS Instructions Modal matching screenshot -->
<div id="pwa-ios-modal" class="pwa-ios-modal">
	<div class="pwa-ios-header">
		<div class="pwa-ios-header-left">
			<div class="pwa-ios-icon">
				<img src="~/assets/images/LeozLogo.jpeg" alt="Logo" />
			</div>
			<div class="pwa-ios-title-wrap">
				<span class="pwa-ios-title">Install Leoz</span>
				<span class="pwa-ios-subtitle">Add to your Home Screen</span>
			</div>
		</div>
		<button id="pwa-ios-close-btn" class="pwa-ios-close" type="button" aria-label="Close">&times;</button>
	</div>

	<div class="pwa-ios-steps">
		<div class="pwa-ios-step">
			<span class="pwa-ios-step-num">1</span>
			<span>Tap the <strong>Share</strong> button <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align: -2px; color: #5ba3f5;"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg> in Safari</span>
		</div>
		<div class="pwa-ios-step">
			<span class="pwa-ios-step-num">2</span>
			<span>Scroll down &amp; select <strong>Add to Home Screen</strong> <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align: -2px; color: #5ba3f5;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg></span>
		</div>
		<div class="pwa-ios-step">
			<span class="pwa-ios-step-num">3</span>
			<span>Tap top-right <strong>Add</strong> to finish!</span>
		</div>
	</div>

	<div class="pwa-ios-footer-note">
		<span>Tap the share icon below</span>
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align: -2px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
	</div>
</div>

<script src="~/js/pwa-install.js" asp-append-version="true"></script>

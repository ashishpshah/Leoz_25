@model ResponseModel<ProjectSiteMaterial>

@{
	Layout = null;

	bool IsVendor = Common.Get_Session_Int(SessionKey.KEY_IS_VENDOR) == 1;
	bool IsCustomer = Common.Get_Session_Int(SessionKey.KEY_IS_CUSTOMER) == 1;
	bool IsEmployee = Common.Get_Session_Int(SessionKey.KEY_IS_EMPLOYEE) == 1;

	// Module permissions (legacy : Manager = Update / Order / Reject, Co-ordinator = Receive, by Employee UserType)
	bool IsManagerUI = (IsEmployee || IsVendor) && Model.Data5 != null && (string)Model.Data5 == "MNGR";
	bool IsCoordinatorUI = (IsEmployee || IsVendor) && Model.Data5 != null && (string)Model.Data5 == "COORD";
	bool CanEditMaterial = ProjectAccess.Check(IsManagerUI, PermissionModules.MPRO, PermissionActions.EDIT);
	bool CanOrderMaterial = ProjectAccess.Check(IsManagerUI, PermissionModules.MPRO, PermissionActions.ORDER);
	bool CanRejectMaterial = ProjectAccess.Check(IsManagerUI, PermissionModules.MPRO, PermissionActions.REJECT);
	bool CanReceiveMaterial = ProjectAccess.Check(IsCoordinatorUI, PermissionModules.MPRO, PermissionActions.RECEIVE);
}

<div class="col-md-12">

	@if (IsEmployee || IsVendor || IsCustomer)
	{
		<form id="formSave" action="@Url.Action("Save_MP","Project", new {  area = "Admin"})" method="post" enctype="multipart/form-data">

			<div class="card-body form-horizontal" id="divProjectSiteDoc" style="display:none">
				<input type="text" class="form-control d-none" name="Id" value="@(Model.Obj != null && Model.Obj.Id > 0 ? Model.Obj.Id.ToString() : "")">
				<input type="text" class="form-control d-none" name="ProjectId" value="@(Model.Obj != null && Model.Obj.ProjectId > 0 ? Model.Obj.ProjectId.ToString() : "")">
				<input type="text" class="form-control d-none" name="CustomerId" value="@(Model.Obj != null && Model.Obj.CustomerId > 0 ? Model.Obj.CustomerId.ToString() : "")">

				<div class="form-group row" style="padding-top:20px">
					<label for="MaterialFor" class="col-md-2 col-form-label">Material For<span style="color:red">*</span></label>
					<div class="col-md-8">
						<input type="text" name="MaterialFor" class="form-control" value="@Model.Obj.MaterialFor">
					</div>					
				</div>
				<div class="form-group row" style="padding-top:20px">					
					<label for="MaterialName" class="col-md-2 col-form-label">Material Name<span style="color:red">*</span></label>
					<div class="col-md-8">
						<input type="text" name="MaterialName" class="form-control" value="@Model.Obj.MaterialName">
					</div>
				</div>
				<div class="form=group row" style="padding-top:20px" >
					<label for="MaterialCode" class="col-md-2 col-form-label">Material Code</label>
					<div class="col-md-8">
						<input type="text" name="MaterialCode" class="form-control" value="@Model.Obj.MaterialCode">
					</div>					
				</div>
				<div class="form=group row" style="padding-top:20px">					
					<label for="MaterialBrand" class="col-md-2 col-form-label">Material Brand</label>
					<div class="col-md-8">
						<input type="text" name="MaterialBrand" class="form-control" value="@Model.Obj.MaterialBrand">
					</div>
				</div>

				@if (CanEditMaterial)
				{
					<div class="form=group row" style="padding-top:20px">
						<label class="col-md-2 col-form-label text-md-end">Required Quantity</label>
						<div class="col-md-8">
							<input type="text" name="Qty" class="form-control isNumberKey_Decimal" value="@Model.Obj.Qty.ToString()" @(Model.Obj != null && Model.Obj.Id > 0 ? "readonly" : "")>
						</div>
					</div>
					<div class="form=group row" style="padding-top:20px">
						<label for="Qty_Order" class="col-md-2 col-form-label">Order Quantity</label>
						<div class="col-md-8">
							<input type="text" name="Qty_Order" class="form-control isNumberKey_Decimal" value="@Model.Obj.Qty_Order.ToString()">
						</div>
					</div>					
				}
				else
				{
					<div class="form=group row" style="padding-top:20px">
						<label for="Qty" class="col-md-2 col-form-label">Quantity</label>
						<div class="col-md-8">
							<input type="text" name="Qty" class="form-control isNumberKey_Decimal" value="@Model.Obj.Qty.ToString()">
						</div>
					</div>
					if (CanReceiveMaterial)
					{
						<div class="form=group row" style="padding-top:20px">

							<label for="Qty_Receive" class="col-md-2 col-form-label divQty_Receive">Receive Quantity</label>
							<div class="col-md-8 divQty_Receive">
								<input type="text" name="Qty_Receive" class="form-control isNumberKey_Decimal" value="@Model.Obj.Qty_Receive.ToString()">
							</div>
						
						</div>
					}


					
						
				}
				

				<div class="form=group row">
					<label for="UOM" class="col-md-2 col-form-label">UOM</label>
					<div class="col-md-8">
						<select name="UOM" class="form-control form-control-sm select2">
							<option value="">-- Select --</option>
							@if (Model.SelectListItems != null)
							{
								var grouped = Model.SelectListItems.GroupBy(i => i.Group).Select(g => new SelectListGroup { Name = g.Key });

								foreach (var group in grouped)
								{
									<optgroup label="@group.Name">
										@foreach (var item in Model.SelectListItems.Where(x => x.Group == group.Name))
										{
											if (Model.Obj.UOM == item.Value)
											{
												<option value="@item.Value" selected>@item.Text</option>
											}
											else
											{
												<option value="@item.Value">@item.Text</option>
											}
										}
									</optgroup>
								}
							}
						</select>
					</div>
				</div>
				
					@if (CanEditMaterial)
					{
						<div class="form=group row">
							<label class="col-md-2 col-form-label">Status</label>
					
							<div class="col-md-8 col-form-label">

								@if (CanOrderMaterial)
								{
								<div class="form-check form-check-inline">
									<input type="radio" id="Ordered" name="Status" class="form-check-input" value="O" @(Model.Obj != null && (Model.Obj.Status == "S" || Model.Obj.Status == "O") ? "checked" : "")>
									<label class="form-check-label" for="Ordered">
										Ordered
									</label>
								</div>
								}
								@if (CanRejectMaterial)
								{
								<div class="form-check form-check-inline">
									<input type="radio" id="Rejected" name="Status" class="form-check-input" value="R" @(Model.Obj != null && Model.Obj.Status == "R" ? "checked" : "")>
									<label class="form-check-label" for="Rejected">
										Rejected
									</label>
								</div>
								}
							</div>
						</div>
					}
				</div>				
				
			
			<div class="card-footer text-center" style="padding-top:20px;display:none" id="divProjectSiteDoc">
				<button type="button" class="btn btn-success btnSubmit">Save</button>
				<button type="button" class="btn btn-secondary" onclick="fnClose_ProjectSiteDoc()">Close</button>
			</div>

		</form>
		@* Material Procurement → Add : Vendor, Customer, Employee (Architect / Purchaser are view only) *@
		@if (ProjectAccess.Check(ProjectAccess.CanAddMaterial, PermissionModules.MPRO, PermissionActions.ADD))
		{
			<div class="d-flex align-items-start justify-content-between">
				<div class="d-flex justify-content-end"> &nbsp; </div>
				<div class="d-flex justify-content-end">
					<button type="button" class="btn btn-primary btn-sm btn-add" onclick="fnAddEdit_ProjectSiteMP(0)"> Add new record </button>
				</div>
			</div>
		}
	}

	<div class="table-responsive-sm mt-3" id="divProjectSiteMPList">
		<table class="table table-bordered table-centered mb-0">
			<thead>
				<tr>
					<th>Material For</th>
					<th>Material Code</th>
					<th>Material Name</th>
					<th>Material Brand</th>
					@if (CanReceiveMaterial)
					{
						<th width="10%">Qty / Received</th>
					}
					else
					{
						<th width="10%">Qty</th>
					}
					@if (CanEditMaterial)
					{
						<th width="20%">Actual Order Qty </th>
					}
					<th width="12%" class="text-center">Status</th>
					<th width="12%" class="text-center">Status Date</th>

					@if (IsEmployee || IsVendor)
					{
						<th class="text-center" width="10%">Action</th>
					}
				</tr>
			</thead>
			<tbody>
				@if (Model.ObjList != null)
				{
					foreach (var item in Model.ObjList.OrderByDescending(x => x.LastModifiedDate?.Ticks))
					{
						<tr>
							<td>@item.MaterialFor</td>
							<td>@item.MaterialCode</td>
							<td>@item.MaterialName</td>
							<td>@item.MaterialBrand</td>
							@if (CanReceiveMaterial && (item.Qty_Receive ?? -1) > -1)
							{
								<td>@item.Qty.ToString() &nbsp; @item.UOM_Text &nbsp; / &nbsp; @item.Qty_Receive.ToString() &nbsp; @item.UOM_Text</td>
							}
							else if (CanReceiveMaterial)
							{
								<td>@item.Qty.ToString() &nbsp; @item.UOM_Text &nbsp;</td>
							}
							else
							{
								<td>@item.Qty.ToString() &nbsp; @item.UOM_Text</td>
							}
							@if (CanEditMaterial)
							{
								<td>
									@if (item.Status == "O")
									{
										<span>@item.Qty_Order.ToString() &nbsp; @item.UOM_Text </span>
									}
								</td>
							}
							<td class="text-center">
								@if (item.Status == "A")
								{
									<span class="badge bg-success py-1 px-2"><i class="ri-checkbox-circle-line me-1"></i>Approved</span>
								}
								else if (item.Status == "O")
								{
									<span class="badge bg-info text-white py-1 px-2"><i class="ri-shopping-cart-2-line me-1"></i>Ordered</span>
								}
								else if (item.Status == "RC")
								{
									<span class="badge bg-primary py-1 px-2"><i class="ri-inbox-archive-line me-1"></i>Received</span>
								}
								else if (item.Status == "R")
								{
									<span class="badge bg-danger py-1 px-2"><i class="ri-close-circle-line me-1"></i>Rejected</span>
								}
								else if (item.Status == "U")
								{
									<span class="badge bg-info text-white py-1 px-2"><i class="ri-upload-cloud-line me-1"></i>Uploaded</span>
								}
								else
								{
									<span class="badge bg-secondary py-1 px-2"><i class="ri-send-plane-line me-1"></i>Submitted</span>
								}
							</td>
							<td class="text-center">@item.StatusDate_Text</td>

							@if ((IsEmployee || IsVendor))
							{
								<td class="text-center">
									@if ((item.Status == "S" || item.Status == "O") && CanEditMaterial)
									{
										<button type="button" class="btn btn-info btn-sm btn-flat" data-toggle="tooltip" data-placement="top" title="Edit"
												onclick="fnAddEdit_ProjectSiteMP(@item.Id);">
											<i class="ri-pencil-fill"></i>
										</button>
									}
									@if ((item.Status == "S" || item.Status == "O") && Model.Data5 != null && (string)Model.Data5 == "MNGR")
									{
										<button type="button" class="btn btn-danger btn-sm btn-flat ml-2" data-toggle="tooltip" data-placement="top" title="Delete"
												onclick="fnDelete_Confirm('@Url.Action("DeleteConfirmed_MP", "Project", new { area = "Admin" })?Id=@item.Id');">
											<i class="ri-delete-bin-2-line"></i>
										</button>
									}

									@if ((item.Status == "S" || item.Status == "O") && CanReceiveMaterial)
									{
										<button type="button" class="btn btn-info btn-sm btn-flat" style="background-color: #f15a07 !important;color: white !important;"
												onclick="fnAddEdit_ProjectSiteMP(@item.Id);">
											Receive
										</button>
									}
								</td>
							}
						</tr>
					}
				}
			</tbody>
		</table>
	</div>

</div>

@section Scripts {
	<script type="text/javascript">
		$(document).ready(function () {

		});
	</script>
}

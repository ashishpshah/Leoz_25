@model Tuple<ResponseModel<ProjectSiteDoc>, ResponseModel<ProjectSiteDoc_History>>

@{
	Layout = null;

	bool IsVendor = Common.Get_Session_Int(SessionKey.KEY_IS_VENDOR) == 1;
	bool IsCustomer = Common.Get_Session_Int(SessionKey.KEY_IS_CUSTOMER) == 1;
	bool IsEmployee = Common.Get_Session_Int(SessionKey.KEY_IS_EMPLOYEE) == 1;

	string UserType = Common.Get_Session("Employee_UserType");
}

<div class="col-md-12">

	@if (ProjectAccess.CanUpload)
	{
		<form id="formSave" action="@Url.Action("Save_Doc","Project", new {  area = "Admin"})" method="post" enctype="multipart/form-data">

			<div class="card-body form-horizontal"id="divProjectSiteDoc" style="display:none">
				<input type="text" class="form-control d-none" name="Id" value="@(Model.Item1.Obj != null && Model.Item1.Obj.Id > 0 ? Model.Item1.Obj.Id.ToString() : "")">
				<input type="text" class="form-control d-none" name="ProjectId" value="@(Model.Item1.Obj != null && Model.Item1.Obj.ProjectId > 0 ? Model.Item1.Obj.ProjectId.ToString() : "")">
				<input type="text" class="form-control d-none" name="CustomerId" value="@(Model.Item1.Obj != null && Model.Item1.Obj.CustomerId > 0 ? Model.Item1.Obj.CustomerId.ToString() : "")">
				<input type="text" class="form-control d-none" name="Type" value="@(Model.Item1.Obj != null ? Model.Item1.Obj.Type : "")">
				<div class="form-group row" style="padding-top:20px">
					<label for="UploadDate_Text" class="col-md-2 col-form-label">Upload Date</label>
					@* <div class="col-md-8">
						@if ((new[] { "F3D", "DRW", "MB" }).Contains(Model.Item1.Obj?.Type) || Model.Item1.Obj?.UploadDate == null)
						{
							<input type="date" name="UploadDate" class="form-control" value="@(DateTime.Now.ToString("yyyy-MM-dd"))">
						}
						else
						{
							<input type="date" name="UploadDate" class="form-control" value="@(Model.Item1.Obj.UploadDate.ToString("yyyy-MM-dd"))">
						}
					</div> *@
					<div class="col-md-8">
						@if ((new[] { "F3D", "DRW", "MB" }).Contains(Model.Item1.Obj?.Type) || Model.Item1.Obj?.UploadDate == null)
						{
							<input type="datetime-local" name="UploadDate" class="form-control"
								   value="@(DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))">
						}
						else
						{
							<input type="datetime-local" name="UploadDate" class="form-control"
								   value="@(Model.Item1.Obj.UploadDate.ToString("yyyy-MM-ddTHH:mm"))">
						}
					</div>
				</div>
				<div class="form-group row" style="padding-top:20px">
					<label for="UploadFile" class="col-md-2 col-form-label">Upload File<span style="color:red">*</span></label>
					<div class="col-md-8">
						<span class="control-fileupload">
							<input type="file" id="UploadFile" accept="image/png, image/jpg, image/jpeg, application/pdf" class="form-control">
						</span>
					</div>
				</div>
				<div class="form-group row" style="padding-top:20px;">
					<label for="Remark" class="col-md-2 col-form-label">Remarks<span style="color:red">*</span></label>
					<div class="col-md-8">
						<input type="text" class="form-control" name="Remark">
					</div>
				</div>			
					
					
			</div>
			<div class="card-footer text-center" style="padding-top:20px;display:none"id="divProjectSiteDoc">
				<button type="button" class="btn btn-success btnSubmit">Save</button>
				<button type="button" class="btn btn-secondary" onclick="fnClose_ProjectSiteDoc()">Close</button>
			</div>

		</form>

		<div class="d-flex align-items-start justify-content-between">
			<div class="d-flex justify-content-end"> &nbsp; </div>
			<div class="d-flex justify-content-end">
				@* Client Scope of Work → Add : Vendor only *@
				@if (Model.Item1.Obj?.Type == "WCLTSC" && !ProjectAccess.CanAddClientScope) { }
				else if (!(Model.Item1.ObjList?.Any() == true && (new[] { "F3D", "DRW", "MB" }).Contains(Model.Item1.Obj?.Type)))
				{
					<button type="button" class="btn btn-primary btn-sm btn-add" onclick="fnAddEdit_ProjectSiteDoc(0,'@(Model.Item1.Obj != null ? Model.Item1.Obj.Type : "")')"> Add new record </button>
				}
				else if (!ProjectAccess.CanModify)
				{
					@* F3D / DRW / MB keep only latest version : uploader without edit rights uploads new version *@
					<button type="button" class="btn btn-primary btn-sm btn-add" onclick="fnAddEdit_ProjectSiteDoc(0,'@(Model.Item1.Obj != null ? Model.Item1.Obj.Type : "")')"> Upload new version </button>
				}
			</div>
		</div>
	}

	<div class="table-responsive-sm mt-3" id="divProjectSiteDocList">
		<table class="table table-bordered table-centered mb-0">
			<thead>
				<tr>
					<th width="20%">Upload Date</th>
					<th>Remarks</th>
					<th width="15%" class="text-center">Status</th>
					<th width="10%" class="text-center">View File</th>
					<th class="text-center" width="15%">Action</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.Item1.ObjList != null)
				{
					foreach (var (item, index) in Model.Item1.ObjList.OrderByDescending(x => x.UploadDate.Ticks).ThenByDescending(x => x.LastModifiedDate?.Ticks).Select((item, index) => (item, index)))
					{
						<tr>
							<td>@item.UploadDate.ToString(Common.DateTimeFormat_ddMMyyyy_HHmm)</td>
							<td>@item.Remark</td>
							<td class="text-center">
								@if (item.Status == "A")
								{
									<span class="badge bg-success py-1 px-2"><i class="ri-checkbox-circle-line me-1"></i>Approved</span>
								}
								else if (item.Status == "R")
								{
									<span class="badge bg-danger py-1 px-2"><i class="ri-close-circle-line me-1"></i>Rejected</span>
								}
								else
								{
									<span class="badge bg-info text-white py-1 px-2"><i class="ri-upload-cloud-line me-1"></i>Uploaded</span>
								}
							</td>
							<td class="text-center">
								@if (index == 0 && item?.FileData != null)
								{
									//<a href="@(Url.Content("~" + item.FilePath))" target="_blank" class="btn btn-info"><i class="ri-file-download-fill me-1"></i> </a>
									<button type="button" class="btn btn-info btn-sm btn-flat" data-toggle="tooltip" data-placement="top" title="Edit"
											onclick="fnView_File_New('@Url.Action("ViewDocument", "Project", new { area = "Admin" })?ProjectId=@item.ProjectId&ProjectSiteDocId=@item.Id&CustomerId=@item.CustomerId', 'View Document');">
										@* onclick="fnView_File('@(Url.Content("~" + item.FilePath))', 'View Document');"> *@
										<i class="ri-file-download-fill me-1"></i>
									</button>
								}
							</td>

							<td class="text-center">
								<div class="btn-group">
									@if (item.Status == "U" && (IsCustomer || ProjectAccess.CanApproveDoc))
									{
										<button type="button" class="btn btn-success btn-sm btn-flat me-1" data-toggle="tooltip" data-placement="top" title="Approve"
												onclick="fnChangeStatus_ProjectSiteDoc(@item.Id, 'A');">
											<i class="ri-checkbox-circle-line me-1"></i>Approve
										</button>
										<button type="button" class="btn btn-danger btn-sm btn-flat me-1" data-toggle="tooltip" data-placement="top" title="Reject"
												onclick="fnChangeStatus_ProjectSiteDoc(@item.Id, 'R');">
											<i class="ri-close-circle-line me-1"></i>Reject
										</button>
									}
									@* Approved / Rejected records are locked : edit only for Uploaded record where file is shown *@
									@if (!IsCustomer && ProjectAccess.CanModify && item.Status != "A" && item.Status != "R" && index == 0 && item?.FileData != null)
									{
										<button type="button" class="btn btn-info btn-sm btn-flat" data-toggle="tooltip" data-placement="top" title="Edit"
												onclick="fnAddEdit_ProjectSiteDoc(@item.Id, '@item.Type');">
											<i class="ri-pencil-fill"></i>
										</button>
									}
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>

	@if ((new[] { "F3D", "DRW", "MB" }).Contains(Model.Item1.Obj?.Type))
	{
		<h5 class="mt-4 mb-2">Recent Uploads</h5>
		<div class="table-responsive-sm mt-3" id="divProjectSiteDocHistoryList">
			<table class="table table-bordered table-centered mb-0">
				<thead>
					<tr>
						<th width="20%">Upload Date</th>
						<th>Remarks</th>
						<th width="15%" class="text-center">Status</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Item2.ObjList != null)
					{
						foreach (var (item, index) in Model.Item2.ObjList.OrderByDescending(x => x.UploadDate.Ticks).ThenByDescending(x => x.LastModifiedDate?.Ticks).Select((item, index) => (item, index)))
						{
							<tr>
								<td>@item.UploadDate.ToString(Common.DateTimeFormat_ddMMyyyy_HHmm)</td>
								<td>@item.Remark</td>
								<td class="text-center">
									@if (item.Status == "A")
									{
										<span class="badge bg-success py-1 px-2"><i class="ri-checkbox-circle-line me-1"></i>Approved</span>
									}
									else if (item.Status == "R")
									{
										<span class="badge bg-danger py-1 px-2"><i class="ri-close-circle-line me-1"></i>Rejected</span>
									}
									else
									{
										<span class="badge bg-info text-white py-1 px-2"><i class="ri-upload-cloud-line me-1"></i>Uploaded</span>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	}
	

</div>

@section Scripts {
	<script type="text/javascript">
		$(document).ready(function () {

		});
	</script>
}
